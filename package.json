{
  "name": "arzio-mail",
  "version": "1.0.0",
  "description": "Arzio Mail: an Outlook 365 style mail, calendar and collaboration service with built-in AI",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "test": "node --no-warnings --test test/*.test.js",
    "create-admin": "node --no-warnings scripts/create-admin.js",
    "backup": "node --no-warnings scripts/backup.js",
    "restore": "node --no-warnings scripts/restore.js",
    "migrate:postgres": "node --no-warnings scripts/migrate-to-postgres.js",
    "migrate:s3": "node --no-warnings scripts/migrate-files-to-s3.js",
    "test:pg": "ARZIO_DB_SCHEMA=auto node --no-warnings --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "imapflow": "^1.7.8",
    "mailauth": "^8.1.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "smtp-server": "^3.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "s3rver": "^3.7.1"
  }
}
