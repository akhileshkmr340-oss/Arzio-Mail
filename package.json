{
  "name": "arzio-mail",
  "version": "0.1.0",
  "description": "Arzio Mail: an Outlook-style mail service with built-in AI assist (Phase 1)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "test": "node --no-warnings --test test/*.test.js",
    "create-admin": "node --no-warnings scripts/create-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "express": "^5.1.0",
    "mailauth": "^8.1.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0",
    "qrcode": "^1.5.4",
    "smtp-server": "^3.14.0"
  }
}
