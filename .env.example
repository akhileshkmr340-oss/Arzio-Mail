# ---- Service ----
ARZIO_SERVICE_NAME="Arzio Mail"
ARZIO_DOMAIN=arzio.com                 # public signup domain: alice@arzio.com
ARZIO_ADMIN_EMAILS=admin@arzio.com     # service admins (can create private organizations)
ARZIO_SIGNUP_OPEN=true
ARZIO_DATA_DIR=./data
# ARZIO_DB_URL=postgres://arzio:password@localhost:5432/arzio   # PostgreSQL instead of SQLite (docs/OPERATIONS.md)
# ARZIO_DB_SSL=true
PORT=3000
SECURE_COOKIES=true                    # true when served over HTTPS
TRUST_PROXY=true                       # true behind nginx / a load balancer

# ---- Quotas ----
ARZIO_MAILBOX_QUOTA_MB=1024
ARZIO_MAX_MESSAGE_MB=25
ARZIO_SENDS_PER_DAY=500

# ---- Inbound (your own MX) ----
INBOUND_SMTP_ENABLED=true
INBOUND_SMTP_PORT=25
INBOUND_TLS_KEY=/etc/letsencrypt/live/mx.arzio.com/privkey.pem
INBOUND_TLS_CERT=/etc/letsencrypt/live/mx.arzio.com/fullchain.pem
INBOUND_WEBHOOK_SECRET=change-me       # for /api/inbound/raw and /api/inbound/postmark

# ---- Mail apps: IMAP and SMTP submission ----
MAIL_PUBLIC_HOST=mail.arzio.com        # shown to users in mail app setup
IMAP_ENABLED=true
IMAP_PORT=993
IMAP_TLS=true
SUBMISSION_ENABLED=true
SUBMISSION_PORT=465
SUBMISSION_TLS=true
MAIL_TLS_KEY=/etc/letsencrypt/live/mail.arzio.com/privkey.pem
MAIL_TLS_CERT=/etc/letsencrypt/live/mail.arzio.com/fullchain.pem

# ---- Outbound via Amazon SES (or Postmark) SMTP relay ----
OUTBOUND_TRANSPORT=relay               # "log" in development writes .eml files to data/outbox
SMTP_RELAY_HOST=email-smtp.ap-south-1.amazonaws.com   # Postmark: smtp.postmarkapp.com
SMTP_RELAY_PORT=587
SMTP_RELAY_SECURE=false
SMTP_RELAY_USER=
SMTP_RELAY_PASS=

# ---- AI ----
AI_PROVIDER=anthropic                  # "none" = built-in basic fallback
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_AUTO_TRIAGE=true

# ---- Operations ----
METRICS_TOKEN=                         # set to require "Authorization: Bearer <token>" on /metrics
ARZIO_MIN_FREE_MB=500                  # /ready fails when the data disk has less free space
ARZIO_MAX_QUEUE_AGE_MIN=60             # /ready warns when outbound mail waits longer
ARZIO_BACKUP_DIR=/opt/arzio/backups
ARZIO_BACKUP_KEEP=14

# ---- Plans and billing ----
ARZIO_BILLING=false                    # true = plans, limits and payments (off for private company servers)
ARZIO_PUBLIC_URL=https://mail.arzio.com   # where payment pages send people back to
BILLING_CURRENCY=INR
BILLING_TAX_NAME=GST
BILLING_TAX_PERCENT=18
BILLING_SELLER="Arzio Technologies"    # shown on invoices
BILLING_SELLER_TAX_ID=                 # your GSTIN / VAT number
BILLING_GRACE_DAYS=7                   # days a failed payment keeps the plan
BILLING_TRIAL_SEATS=5                  # users an organization gets before it pays
BILLING_DEFAULT_ORG_PLAN=business_basic
BILLING_PROVIDER=                      # razorpay | stripe (default: Razorpay for INR if set up)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=               # webhook URL: https://mail.arzio.com/webhooks/razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                 # webhook URL: https://mail.arzio.com/webhooks/stripe

# ---- S3-compatible storage for mail files (optional) ----
# ARZIO_S3_BUCKET=arzio-mail
# ARZIO_S3_REGION=ap-south-1
# ARZIO_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# ARZIO_S3_ACCESS_KEY=
# ARZIO_S3_SECRET_KEY=
# ARZIO_S3_PATH_STYLE=false
# ARZIO_S3_PREFIX=mail
