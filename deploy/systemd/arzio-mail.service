# Run Arzio Mail without Docker.
#   sudo useradd --system --home /opt/arzio --shell /usr/sbin/nologin arzio
#   sudo cp deploy/systemd/arzio-mail.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now arzio-mail
[Unit]
Description=Arzio Mail
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arzio
Group=arzio
WorkingDirectory=/opt/arzio/app
EnvironmentFile=/opt/arzio/app/.env
Environment=NODE_ENV=production
Environment=ARZIO_DATA_DIR=/opt/arzio/data
ExecStart=/usr/bin/node --no-warnings src/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
# Lets the service listen on ports 25, 465 and 993 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/arzio/data /opt/arzio/backups
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
